# Template for ~/.config/tmux-sessionizer/tmux-sessionizer.conf — like a
# .env.example. The workstation `tmux` role copies it there once and never
# overwrites it; that copy is per-machine and lives outside any repo.
# Put your machine's project layout there, not here.
#
# Each entry's immediate children become picker entries. Append :N to a path
# to search N levels deep for just that path. Left empty, the picker falls
# back to ~ (depth TS_MAX_DEPTH).
#
# Example:
#   TS_SEARCH_PATHS=(
#       ~
#       ~/.config
#       ~/projects
#       ~/projects/some-monorepo
#   )
TS_SEARCH_PATHS=()
TS_MAX_DEPTH=1
